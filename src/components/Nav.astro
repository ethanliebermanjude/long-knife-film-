---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const primaryLinks = [
  { href: "/crimes", label: "The Crimes" },
  { href: "/osage", label: "The Osage" },
  { href: "/music", label: "The Music" },
];

const moreLinks = [
  { href: "/filmmakers", label: "The Filmmakers" },
  { href: "/press", label: "Press" },
  { href: "/gallery", label: "Photo Gallery" },
];

// Mobile menu shows everything flat — no nested dropdown on small screens.
const mobileLinks = [
  { href: "/", label: "Home" },
  ...primaryLinks,
  ...moreLinks,
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
};

const isMoreActive = moreLinks.some((l) => isActive(l.href));
---

<header
  class="fixed top-0 right-0 left-0 z-50 border-b border-white/10 bg-[color-mix(in_srgb,var(--color-ink)_85%,transparent)] backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-8"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-[family-name:var(--font-display)] text-2xl tracking-wider text-[var(--color-bone)]"
    >
      LONG KNIFE
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 lg:flex">
      {
        primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-[11px] tracking-[0.25em] uppercase transition-colors",
                isActive(link.href)
                  ? "text-[var(--color-red)]"
                  : "text-white/70 hover:text-[var(--color-bone)]",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }

      <!-- More dropdown -->
      <li class="group relative">
        <button
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          class:list={[
            "inline-flex items-center gap-2 text-[11px] tracking-[0.25em] uppercase transition-colors group-hover:text-[var(--color-bone)] group-focus-within:text-[var(--color-bone)]",
            isMoreActive ? "text-[var(--color-red)]" : "text-white/70",
          ]}
        >
          More
          <svg
            class="h-2 w-2.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"
            viewBox="0 0 10 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M1 1 L5 5 L9 1"></path>
          </svg>
        </button>
        <!-- Invisible hover-bridge so the menu doesn't close while crossing the gap -->
        <div
          class="pointer-events-none absolute top-full right-0 h-3 w-full group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
          aria-hidden="true"
        >
        </div>
        <ul
          class="invisible absolute top-full right-0 mt-3 min-w-[200px] -translate-y-1 flex-col border border-white/10 bg-[color-mix(in_srgb,var(--color-ink)_95%,transparent)] py-2 opacity-0 shadow-2xl backdrop-blur-md transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
          style="display: flex;"
        >
          {
            moreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "block px-5 py-3 text-[11px] tracking-[0.25em] uppercase transition-colors",
                    isActive(link.href)
                      ? "text-[var(--color-red)]"
                      : "text-white/80 hover:bg-white/5 hover:text-[var(--color-bone)]",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>

    <!-- Mobile nav toggle -->
    <button
      type="button"
      id="nav-toggle"
      class="lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="block h-px w-6 bg-[var(--color-bone)]"></span>
      <span class="mt-1.5 block h-px w-6 bg-[var(--color-bone)]"></span>
      <span class="mt-1.5 block h-px w-6 bg-[var(--color-bone)]"></span>
    </button>
  </nav>

  <!-- Mobile nav panel -->
  <div
    id="mobile-nav"
    class="hidden border-t border-white/10 lg:hidden"
    aria-hidden="true"
  >
    <ul class="flex flex-col py-2">
      {
        mobileLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block px-6 py-4 text-xs tracking-[0.3em] uppercase transition-colors",
                isActive(link.href)
                  ? "text-[var(--color-red)]"
                  : "text-white/80 hover:bg-white/5 hover:text-[var(--color-bone)]",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = !panel.classList.contains("hidden");
      panel.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.setAttribute("aria-hidden", String(isOpen));
    });
  }
</script>
