---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}

const { eyebrow = "A True Crime Documentary", title, subtitle } = Astro.props;
---

<section
  class="relative flex min-h-[70vh] flex-col items-center justify-center overflow-hidden px-6 pt-32 pb-20 text-center"
>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/60"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <p
      class="mb-6 text-xs tracking-[0.4em] text-[var(--color-red)] uppercase sm:text-sm"
    >
      {eyebrow}
    </p>
    <h1
      class="font-[family-name:var(--font-display)] text-[clamp(3rem,12vw,9rem)] leading-[0.9] tracking-tight"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mx-auto mt-6 max-w-2xl font-[family-name:var(--font-quote)] text-lg italic sm:text-xl md:text-2xl">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
