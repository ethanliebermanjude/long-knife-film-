---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---

<Base
  title="The Environment — Long Knife"
  description="An environmental justice story. Thousands of uncapped, abandoned oil wells leaking across Osage County to this day."
>
  <PageHero
    eyebrow="Chapter 02"
    title="THE ENVIRONMENT"
    subtitle="The wells they left behind."
  />

  <section class="px-6 py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-white/80 sm:text-xl">
        <span class="text-white/40 italic">
          [Lede &mdash; TK. Frame Long Knife as an environmental justice story
          as much as a true crime story. Open with the scale of the abandonment:
          how many wells, how long they've been leaking, what they're leaking
          into the soil and water.]
        </span>
      </p>
    </div>
  </section>

  <!-- Stats / scale -->
  <section class="border-y border-white/10 bg-black/30 px-6 py-24">
    <div class="mx-auto grid max-w-5xl gap-12 text-center sm:grid-cols-3">
      <div>
        <p
          class="font-[family-name:var(--font-display)] text-6xl tracking-tight text-[var(--color-red)]"
        >
          [TK]
        </p>
        <p
          class="mt-2 text-[10px] tracking-[0.3em] text-white/50 uppercase"
        >
          Abandoned Wells
        </p>
      </div>
      <div>
        <p
          class="font-[family-name:var(--font-display)] text-6xl tracking-tight text-[var(--color-red)]"
        >
          [TK]
        </p>
        <p
          class="mt-2 text-[10px] tracking-[0.3em] text-white/50 uppercase"
        >
          Years Leaking
        </p>
      </div>
      <div>
        <p
          class="font-[family-name:var(--font-display)] text-6xl tracking-tight text-[var(--color-red)]"
        >
          [TK]
        </p>
        <p
          class="mt-2 text-[10px] tracking-[0.3em] text-white/50 uppercase"
        >
          Square Miles of Osage County
        </p>
      </div>
    </div>
  </section>

  <!-- Long-form -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-3xl space-y-6 text-lg leading-relaxed text-white/80 sm:text-xl">
      <p class="text-white/40 italic">
        [TK &mdash; the environmental justice case. Who is responsible, who's on
        the hook for cleanup, and who has been left to live with the
        contamination.]
      </p>
      <p class="text-white/40 italic">
        [TK &mdash; what the film documents firsthand: the wells, the
        groundwater, the people living next door to abandoned infrastructure.]
      </p>
    </div>
  </section>
</Base>
