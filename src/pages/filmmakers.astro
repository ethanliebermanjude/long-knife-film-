---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---

<Base
  title="The Filmmakers — Long Knife"
  description="The team behind Long Knife. Narrated by Robert De Niro. Directed by David Ambrose. Written and produced by Greg Palast."
>
  <PageHero
    eyebrow="The Team"
    title="THE FILMMAKERS"
    subtitle="The people who made Long Knife."
  />

  <section class="px-6 pb-8">
    <figure class="mx-auto max-w-4xl">
      <img
        src="/filmmakers-team.jpg"
        alt="Members of the Long Knife team together in the studio."
        class="w-full border border-white/10 shadow-2xl"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="px-6 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <dl class="space-y-10">
        <div>
          <dt
            class="text-xs tracking-[0.3em] text-white/50 uppercase sm:text-sm"
          >
            Narrated by
          </dt>
          <dd
            class="mt-3 font-[family-name:var(--font-quote)] text-3xl sm:text-4xl"
          >
            Robert De Niro
          </dd>
        </div>
        <div>
          <dt
            class="text-xs tracking-[0.3em] text-white/50 uppercase sm:text-sm"
          >
            Directed by
          </dt>
          <dd
            class="mt-3 font-[family-name:var(--font-quote)] text-3xl sm:text-4xl"
          >
            David Ambrose
          </dd>
        </div>
        <div>
          <dt
            class="text-xs tracking-[0.3em] text-white/50 uppercase sm:text-sm"
          >
            Written &amp; Produced by
          </dt>
          <dd
            class="mt-3 font-[family-name:var(--font-quote)] text-3xl sm:text-4xl"
          >
            Greg Palast
          </dd>
        </div>
        <div>
          <dt
            class="text-xs tracking-[0.3em] text-white/50 uppercase sm:text-sm"
          >
            Produced by
          </dt>
          <dd
            class="mt-3 space-y-1 font-[family-name:var(--font-quote)] text-2xl sm:text-3xl"
          >
            <p>David Ambrose</p>
            <p>Stephen Nemeth</p>
            <p>George DiCaprio</p>
            <p>Geoffrey Standing Bear</p>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
