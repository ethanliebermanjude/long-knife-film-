---
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="relative">
    <!-- Hero -->
    <section
      class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-24 text-center"
    >
      <!-- Subtle vertical gradient to give the dark some depth -->
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/60"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-5xl">
        <p
          class="mb-6 text-xs tracking-[0.4em] text-[var(--color-rust)] uppercase sm:text-sm"
        >
          A True Crime Documentary
        </p>

        <h1
          class="font-[family-name:var(--font-display)] text-[clamp(4rem,18vw,15rem)] leading-[0.85] tracking-tight"
        >
          LONG KNIFE
        </h1>

        <p
          class="mt-8 text-sm font-light tracking-[0.3em] uppercase sm:text-base"
        >
          Narrated by <span class="text-[var(--color-bone)]"
            >Robert De Niro</span
          >
        </p>

        <p
          class="mx-auto mt-12 max-w-2xl font-[family-name:var(--font-quote)] text-xl leading-relaxed italic sm:text-2xl md:text-3xl"
        >
          A gang so powerful they don't operate on the street&hellip; they work
          from Koch Oil corporate headquarters.
        </p>

        <div
          class="mt-16 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6"
        >
          <a
            href="#trailer"
            class="group relative inline-flex items-center gap-3 border border-[var(--color-bone)] px-8 py-4 text-xs tracking-[0.3em] uppercase transition-colors hover:bg-[var(--color-bone)] hover:text-[var(--color-ink)]"
          >
            <svg
              class="h-3 w-3"
              viewBox="0 0 12 12"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M2 1 L10 6 L2 11 Z"></path>
            </svg>
            Watch the Trailer
          </a>
          <a
            href="#support"
            class="inline-flex items-center gap-3 bg-[var(--color-rust)] px-8 py-4 text-xs tracking-[0.3em] uppercase transition-colors hover:bg-[var(--color-rust-deep)]"
          >
            Support the Film
          </a>
        </div>

        <p class="mt-20 text-[10px] tracking-[0.3em] text-white/40 uppercase">
          The Documentary Sequel to <em class="not-italic"
            >Killers of the Flower Moon</em
          >
        </p>
      </div>

      <!-- Scroll cue -->
      <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/30"
        aria-hidden="true"
      >
        <div class="h-12 w-px animate-pulse bg-white/30"></div>
      </div>
    </section>

    <!-- Pull quote -->
    <section
      class="border-y border-white/10 px-6 py-32 text-center sm:py-48"
    >
      <p
        class="mx-auto max-w-4xl font-[family-name:var(--font-quote)] text-2xl leading-tight italic sm:text-4xl md:text-5xl"
      >
        "Behind every great fortune is a great crime.
        <span class="block text-[var(--color-rust)] sm:mt-4">
          This is the crime.
        </span>"
      </p>
    </section>

    <!-- Placeholder sections for the rest of the page -->
    <section id="trailer" class="px-6 py-32 text-center">
      <p class="text-xs tracking-[0.4em] text-white/40 uppercase">
        Trailer · Coming Soon
      </p>
    </section>

    <section id="support" class="px-6 py-32 text-center">
      <p class="text-xs tracking-[0.4em] text-white/40 uppercase">
        Support the Film · Coming Soon
      </p>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 px-6 py-12 text-center">
      <p class="text-[10px] tracking-[0.3em] text-white/40 uppercase">
        &copy; 2026 Palast Investigative Fund
      </p>
    </footer>
  </main>
</Base>
