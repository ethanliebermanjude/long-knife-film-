---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const investigators = [
  {
    name: "Everett Waller",
    role: "Osage Minerals Council",
    quote: "I hope he enjoys those words in hell.",
    portrait: "/waller.jpg",
  },
  {
    name: "Jim Elroy",
    role: "Dirty Harry of the FBI",
    quote: "He would have gotten 70 years.",
    portrait: "/elroy.jpg",
  },
  {
    name: "Jim Parris",
    role: "Koch Insider · Whistleblower",
    quote: "They were burning the documents.",
    footnote: "Fired.",
  },
  {
    name: "Greg Palast",
    role: "Investigative Journalist",
    quote: "The Kochs' billions came from oil stolen right here.",
    portrait: "/palast.jpg",
  },
  {
    name: "Ken Ballen",
    role: "Federal Prosecutor",
    quote: "My God — here was the evidence.",
    portrait: "/ballen.jpg",
  },
];

const evidence = [
  "Buried recording of Charlie Koch confessing to the heist",
  "Internal Koch memos saved from the burn barrel by workers forced to steal",
  "Secret Koch documents totaling up the skim",
  "Sealed FBI records",
];
---

<Base
  title="The Investigators — Long Knife"
  description="Hunted, harassed, threatened — for revealing the hard evidence of one of the greatest heists in US history."
>
  <PageHero title="THE INVESTIGATORS" />

  <!-- Lede -->
  <section class="px-6 py-20">
    <div
      class="mx-auto max-w-3xl space-y-6 text-lg leading-relaxed text-white/85 sm:text-xl"
    >
      <p>
        Hunted, harassed, threatened &mdash; for revealing the hard evidence of
        one of the greatest heists in US history: stealing the oil, the cash,
        and the US government.
      </p>
      <p>
        How Koch got away with it&hellip; until now.
      </p>
      <p class="text-white/70">
        Follow them on the hunt for the story. Here's the evidence. You decide.
      </p>
    </div>
  </section>

  <!-- The Evidence -->
  <section class="border-y border-white/10 bg-black/30 px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <figure>
        <img
          src="/koch-rico-document.jpg"
          alt="An FBI document: 'Charles Koch, Koch Industries — Crime on an Indian Reservation, Theft; Racketeering Influence and Corrupt Organization,' dated July 26, 1989."
          class="mx-auto w-full max-w-3xl border border-white/10 shadow-2xl"
          loading="lazy"
        />
        <figcaption class="mx-auto mt-4 max-w-3xl text-center text-[10px] tracking-[0.3em] text-white/40 uppercase">
          FBI file: theft and racketeering on the Osage Reservation, 1989
        </figcaption>
      </figure>

      <div class="mt-8 grid gap-px bg-white/10 sm:grid-cols-2">
        <figure class="bg-[var(--color-ink)]">
          <img
            src="/evidence-koch-memos.jpg"
            alt="Burning Koch Industries memorandum — internal memos saved from the burn barrel."
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </figure>
        <figure class="bg-[var(--color-ink)]">
          <img
            src="/over-short-chart.jpg"
            alt="A Koch accounting chart titled 'Over/(Short)' tallying barrels skimmed, in thousands."
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </figure>
      </div>

      <ul class="mt-14 grid gap-px bg-white/10 sm:grid-cols-2">
        {
          evidence.map((item) => (
            <li class="bg-[var(--color-ink)] p-8 sm:p-10">
              <p class="text-base leading-relaxed text-white/85 sm:text-lg">
                {item}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Who built it -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <ul class="space-y-px bg-white/10">
        {
          investigators.map((person, index) => {
            const isReversed = index % 2 === 1;
            return (
              <li class="bg-[var(--color-ink)]">
                <div
                  class:list={[
                    "mx-auto max-w-5xl px-6 py-10 sm:px-10 md:flex md:items-center md:gap-10",
                    isReversed && "md:flex-row-reverse",
                  ]}
                >
                  {person.portrait ? (
                    <div class="mb-6 w-32 md:mb-0 md:w-40 md:flex-shrink-0">
                      <div class="aspect-[4/5] overflow-hidden border border-white/10 bg-black/30">
                        <img
                          src={person.portrait}
                          alt={`Portrait of ${person.name}`}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  ) : (
                    <div
                      class="hidden md:block md:w-40 md:flex-shrink-0"
                      aria-hidden="true"
                    />
                  )}
                  <div class="md:flex-1">
                    <p class="text-[10px] tracking-[0.3em] text-[var(--color-red)] uppercase sm:text-xs">
                      {person.role}
                    </p>
                    <p class="mt-2 font-[family-name:var(--font-display)] text-3xl tracking-tight sm:text-4xl">
                      {person.name}
                    </p>
                    <p class="mt-4 font-[family-name:var(--font-quote)] text-xl leading-snug italic text-white/85 sm:text-2xl md:text-3xl">
                      &ldquo;{person.quote}&rdquo;
                    </p>
                    {person.footnote && (
                      <p class="mt-3 text-[10px] tracking-[0.3em] text-white/50 uppercase sm:text-xs">
                        {person.footnote}
                      </p>
                    )}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
