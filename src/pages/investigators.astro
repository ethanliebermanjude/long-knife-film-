---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const investigators = [
  {
    name: "Everett Waller",
    role: "Osage Minerals Council",
    quote: "I hope he enjoys those words in hell.",
  },
  {
    name: "Jim Elroy",
    role: "Dirty Harry of the FBI",
    quote: "He would have gotten 70 years.",
  },
  {
    name: "Jim Parris",
    role: "Koch Insider · Whistleblower",
    quote: "They were burning the documents.",
    footnote: "Fired.",
  },
  {
    name: "Greg Palast",
    role: "Investigative Journalist",
    quote: "The Kochs' billions came from oil stolen right here.",
  },
  {
    name: "Ken Ballen",
    role: "Federal Prosecutor",
    quote: "My God — here was the evidence.",
  },
];

const evidence = [
  "Buried recording of Charlie Koch confessing to the heist",
  "Internal Koch memos saved from the burn barrel by workers forced to steal",
  "Secret Koch documents totaling up the skim",
  "Sealed FBI records",
];
---

<Base
  title="The Investigators — Long Knife"
  description="Hunted, harassed, threatened — for revealing the hard evidence of one of the greatest heists in US history."
>
  <PageHero
    title="THE INVESTIGATORS"
    subtitle="The criminal case against Charles Koch."
  />

  <!-- Lede -->
  <section class="px-6 py-20">
    <div
      class="mx-auto max-w-3xl space-y-6 text-lg leading-relaxed text-white/85 sm:text-xl"
    >
      <p>
        Hunted, harassed, threatened &mdash; for revealing the hard evidence of
        one of the greatest heists in US history: stealing the oil, the cash,
        and the US government.
      </p>
      <p>
        How Koch got away with it&hellip; until now.
      </p>
      <p class="text-white/70">
        Follow them on the hunt for the story. Here's the evidence. You decide.
      </p>
    </div>
  </section>

  <!-- The Evidence -->
  <section class="border-y border-white/10 bg-black/30 px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <p
        class="mb-4 text-center text-xs tracking-[0.4em] text-[var(--color-red)] uppercase"
      >
        Painstaking. Buried. Recovered.
      </p>
      <h2
        class="text-center font-[family-name:var(--font-display)] text-4xl leading-tight tracking-tight sm:text-6xl"
      >
        The Evidence.
      </h2>

      <figure class="mt-12">
        <img
          src="/evidence-mugshot.webp"
          alt="Archival evidence still from Long Knife — a black-and-white frame against a height-measurement chart."
          class="mx-auto w-full max-w-2xl border border-white/10 shadow-2xl"
          loading="lazy"
        />
      </figure>

      <ul class="mt-14 grid gap-px bg-white/10 sm:grid-cols-2">
        {
          evidence.map((item) => (
            <li class="bg-[var(--color-ink)] p-8 sm:p-10">
              <p class="text-base leading-relaxed text-white/85 sm:text-lg">
                {item}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Who built it -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <p
        class="mb-4 text-center text-xs tracking-[0.4em] text-[var(--color-red)] uppercase"
      >
        On the Hunt
      </p>
      <h2
        class="text-center font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
      >
        Who built it.
      </h2>

      <ul class="mt-14 space-y-px bg-white/10">
        {
          investigators.map((person) => (
            <li class="bg-[var(--color-ink)] px-6 py-10 sm:px-10">
              <div class="mx-auto max-w-4xl">
                <p class="text-[10px] tracking-[0.3em] text-[var(--color-red)] uppercase sm:text-xs">
                  {person.role}
                </p>
                <p class="mt-2 font-[family-name:var(--font-display)] text-3xl tracking-tight sm:text-4xl">
                  {person.name}
                </p>
                <p class="mt-4 font-[family-name:var(--font-quote)] text-xl leading-snug italic text-white/85 sm:text-2xl md:text-3xl">
                  &ldquo;{person.quote}&rdquo;
                </p>
                {person.footnote && (
                  <p class="mt-3 text-[10px] tracking-[0.3em] text-white/50 uppercase sm:text-xs">
                    {person.footnote}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
