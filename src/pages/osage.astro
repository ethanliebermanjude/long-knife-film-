---
import Base from "../layouts/Base.astro";

const voices = [
  {
    name: "Geoffrey Standing Bear",
    role: "Principal Chief, Osage Nation",
    image: "/osage-standing-bear.jpg",
    bio: [
      "Principal Chief of the Osage Nation, a trial lawyer, and a consulting producer on <cite>Long Knife</cite>. He is filing lawsuits and leading the campaign to take back control of the Nation's land — and to shut down the abandoned wells still poisoning it.",
    ],
  },
  {
    name: "Everett Waller",
    role: "Chairman, Osage Minerals Council",
    image: "/osage-waller.jpg",
    bio: [
      "Chairman of the Osage Minerals Council — and, as the film's narrator Robert De Niro puts it, an Osage hunter who tracks down the oil rustlers. He has spent years chasing the theft of his Nation's crude.",
    ],
  },
  {
    name: "Tara Damron",
    role: "Osage Nation",
    image: "/osage-damron.jpg",
    bio: [],
  },
];
---

<Base
  title="The Osage — Long Knife"
  description="The Osage Nation: once the richest people in the world, and still fighting for sovereignty over their own land. The story Killers of the Flower Moon began."
>
  <!-- Hero: Everett Waller & Marian (no text overlay) -->
  <section class="pt-16 sm:pt-20">
    <figure class="relative aspect-video w-full overflow-hidden">
      <img
        src="/osage-couple.jpg"
        alt="Everett Waller and Marian on the Osage prairie in traditional regalia."
        class="h-full w-full object-cover"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--color-ink)]"
      >
      </div>
    </figure>
  </section>

  <!-- Title + lede -->
  <section class="px-6 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <h1
        class="font-[family-name:var(--font-display)] text-[clamp(2.5rem,8vw,5rem)] leading-[0.95] tracking-tight"
      >
        THE OSAGE
      </h1>
      <p
        class="mt-4 font-[family-name:var(--font-quote)] text-xl text-white/80 italic sm:text-2xl"
      >
        Sovereignty, dignity, and the story Hollywood didn't finish.
      </p>
      <div
        class="mt-10 space-y-6 text-lg leading-relaxed text-white/85 sm:text-xl"
      >
        <p
          class="font-[family-name:var(--font-quote)] text-3xl leading-tight text-white italic sm:text-4xl"
        >
          The richest people in the world.
        </p>
      <p>
        In the 1870s, starvation and smallpox killed 90% of the tribe. Then oil
        was discovered beneath their land — and by 1919 the Osage Nation held
        the most valuable mineral rights on the continent, the richest people on
        earth per capita.
      </p>
        <p>
          <cite>Long Knife</cite> is the story of what happened next — and of
          what is still happening. It is the documentary sequel to
          <cite>Killers of the Flower Moon</cite>: same land, same wealth,
          different criminals.
        </p>
      </div>
    </div>
  </section>

  <!-- Sovereignty -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-3xl space-y-6 text-lg leading-relaxed text-white/85 sm:text-xl">
      <p class="text-xs tracking-[0.4em] text-[var(--color-red)] uppercase">
        Sovereignty
      </p>
      <p>
        Big Oil sucked billions of dollars in petroleum from the reservation and
        walked away, leaving the Tribe with thousands of abandoned wells leaking
        chemicals and methane. The Osage are blocked from cleaning the filth on
        their own land — and from controlling their own property, which is still
        lorded over by the Bureau of Indian Affairs.
      </p>
      <p>
        Chief Standing Bear, a militant trial lawyer, is not waiting to find out
        how the story ends. He is filing lawsuits and leading a campaign to take
        back control of his Nation's land and shut down the earth-destroying
        methane belching into the atmosphere.
      </p>
      <blockquote
        class="border-l-2 border-[var(--color-red)] pl-6 font-[family-name:var(--font-quote)] text-2xl leading-snug text-white italic sm:text-3xl"
      >
        &ldquo;Now how do you allow a company to just walk away like
        that?&rdquo;
        <cite
          class="mt-4 block font-[family-name:var(--font-body)] text-[10px] tracking-[0.3em] text-white/50 not-italic uppercase"
        >
          — Everett Waller, Chairman, Osage Minerals Council
        </cite>
      </blockquote>
    </div>
  </section>

  <!-- Occupied territory -->
  <section class="border-y border-white/10 bg-black/30 px-6 py-28 text-center">
    <p
      class="mx-auto max-w-4xl font-[family-name:var(--font-quote)] text-3xl leading-tight text-white italic sm:text-5xl"
    >
      &ldquo;Let's not beat around the bush.
      <span class="block text-[var(--color-red)] sm:mt-3">
        This is occupied territory.&rdquo;
      </span>
    </p>
    <p class="mt-8 text-[10px] tracking-[0.3em] text-white/50 uppercase">
      — Principal Chief Geoffrey Standing Bear
    </p>
  </section>

  <!-- Living culture -->
  <section class="px-6 py-16">
    <div class="mx-auto grid max-w-5xl gap-px bg-white/10 sm:grid-cols-2">
      <figure class="bg-[var(--color-ink)]">
        <img
          src="/osage-dancer.jpg"
          alt="An Osage dancer in full feather regalia mid-dance."
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
        />
      </figure>
      <figure class="bg-[var(--color-ink)]">
        <img
          src="/osage-drum-circle.jpg"
          alt="An Osage drum circle, singers around the drum with dancers in regalia."
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- Voices -->
  <section class="border-t border-white/10 px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <p
        class="mb-4 text-center text-xs tracking-[0.4em] text-[var(--color-red)] uppercase"
      >
        Osage Voices in the Film
      </p>
      <h2
        class="text-center font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
      >
        Featured in Long Knife.
      </h2>

      <ul class="mt-16 space-y-16 sm:space-y-24">
        {
          voices.map((v, index) => {
            const isReversed = index % 2 === 1;
            return (
              <li>
                <div
                  class:list={[
                    "md:flex md:items-center md:gap-12",
                    isReversed && "md:flex-row-reverse",
                  ]}
                >
                  <div class="md:w-1/2 md:flex-shrink-0">
                    <div class="aspect-[3/2] overflow-hidden border border-white/10 bg-black/30">
                      <img
                        src={v.image}
                        alt={v.name}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  </div>
                  <div class="mt-6 md:mt-0 md:w-1/2">
                    <p class="text-[10px] tracking-[0.3em] text-[var(--color-red)] uppercase sm:text-xs">
                      {v.role}
                    </p>
                    <h3 class="mt-2 font-[family-name:var(--font-quote)] text-4xl leading-tight sm:text-5xl">
                      {v.name}
                    </h3>
                    {v.bio.length > 0 && (
                      <div class="mt-5 space-y-4 text-base leading-relaxed text-white/75">
                        {v.bio.map((para) => (
                          <p set:html={para} />
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Bridge to the crimes -->
  <section class="border-t border-white/10 px-6 py-24 text-center">
    <p
      class="mx-auto max-w-3xl font-[family-name:var(--font-quote)] text-2xl leading-tight italic sm:text-3xl"
    >
      The oil was stolen. The land was poisoned. The story is not over.
    </p>
    <div class="mt-10">
      <a
        href="/crimes"
        class="inline-flex items-center gap-3 border border-[var(--color-bone)] px-8 py-4 text-xs tracking-[0.3em] uppercase transition-colors hover:bg-[var(--color-bone)] hover:text-[var(--color-ink)]"
      >
        See the Crimes
      </a>
    </div>
  </section>
</Base>
