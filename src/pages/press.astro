---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const facts = [
  { label: "Narrated by", value: "Robert De Niro" },
  { label: "Directed by", value: "David Ambrose" },
  { label: "Written & Produced by", value: "Greg Palast" },
  {
    label: "Produced by",
    value: "David Ambrose · Stephen Nemeth · George DiCaprio · Geoffrey Standing Bear",
  },
  {
    label: "Featuring",
    value:
      "Principal Chief Geoffrey Standing Bear · Everett Waller · Jim Elroy · Ken Ballen",
  },
  {
    label: "Subject",
    value: "The theft of $6 billion in oil from the Osage Nation — and the company now known as Koch Industries",
  },
  { label: "Fiscal Sponsor", value: "Palast Investigative Fund" },
];

const guardianUrl =
  "https://www.theguardian.com/commentisfree/2023/oct/20/martin-scorsese-killers-of-the-flower-moon-osage-us-government";
---

<Base
  title="Press — Long Knife"
  description="Press materials and media contact for Long Knife, a true crime documentary narrated by Robert De Niro about the Osage Nation and Koch Industries."
>
  <PageHero
    eyebrow="For Journalists"
    title="PRESS"
    subtitle="Press materials and media contact for Long Knife."
  />

  <!-- Logline -->
  <section class="px-6 py-20 sm:py-24">
    <div
      class="mx-auto max-w-3xl space-y-6 text-lg leading-relaxed text-white/85 sm:text-xl"
    >
      <p
        class="font-[family-name:var(--font-quote)] text-2xl text-white italic sm:text-3xl"
      >
        A true crime documentary narrated by Robert De Niro.
      </p>
      <p>
        <cite>Long Knife</cite> tells the story of the biggest oil heist in U.S.
        history &mdash; over $6 billion stolen from the Osage Nation by the
        company now known as Koch Industries &mdash; and the Osage-led fight to
        take it back. It is the documentary sequel to
        <cite>Killers of the Flower Moon</cite>.
      </p>
    </div>
  </section>

  <!-- Fact sheet -->
  <section class="border-y border-white/10 bg-black/30 px-6 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p
        class="mb-10 text-center text-xs tracking-[0.4em] text-[var(--color-red)] uppercase"
      >
        The Film at a Glance
      </p>
      <dl class="divide-y divide-white/10">
        {
          facts.map((f) => (
            <div class="grid gap-1 py-5 sm:grid-cols-[200px_1fr] sm:gap-8">
              <dt class="pt-1 text-[10px] tracking-[0.3em] text-white/50 uppercase">
                {f.label}
              </dt>
              <dd class="text-base text-white/90 sm:text-lg">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Further reading -->
  <section class="px-6 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p
        class="mb-8 text-center text-xs tracking-[0.4em] text-[var(--color-red)] uppercase"
      >
        Further Reading
      </p>
      <a
        href={guardianUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group block border border-white/10 p-8 transition-colors hover:border-white/30 hover:bg-white/5 sm:p-10"
      >
        <p class="text-[10px] tracking-[0.3em] text-white/50 uppercase">
          The Guardian &middot; 20 October 2023
        </p>
        <h3
          class="mt-4 font-[family-name:var(--font-quote)] text-2xl leading-snug text-white italic transition-colors group-hover:text-[var(--color-bone)] sm:text-3xl"
        >
          &ldquo;The Osage want you to know their story doesn't end with Killers
          of the Flower Moon&rdquo;
        </h3>
        <p class="mt-5 text-base leading-relaxed text-white/70 sm:text-lg">
          By Greg Palast. The Reign of Terror was only the beginning: the Osage
          oil that built the Koch family's fortune is still being taken, and the
          Nation is still fighting to cap the abandoned wells poisoning its land.
        </p>
        <p
          class="mt-6 text-[10px] tracking-[0.3em] text-[var(--color-red)] uppercase"
        >
          Read at The Guardian &rarr;
        </p>
      </a>
    </div>
  </section>

  <!-- Press materials -->
  <section class="px-6 py-24 text-center">
    <p class="text-xs tracking-[0.4em] text-[var(--color-red)] uppercase">
      Press Materials
    </p>
    <h2
      class="mt-4 font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
    >
      Available on request.
    </h2>
    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75 sm:text-xl"
    >
      High-resolution stills, the electronic press kit, and interview requests
      with the filmmakers are available to accredited press. Get in touch and
      we'll send materials over.
    </p>
  </section>

  <!-- Press contact -->
  <section class="border-t border-white/10 px-6 py-24 text-center">
    <p class="text-xs tracking-[0.4em] text-[var(--color-red)] uppercase">
      Press Contact
    </p>
    <p
      class="mt-4 font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
    >
      Get in touch.
    </p>
    <a
      href="mailto:office@gregpalast.com"
      class="mt-8 inline-block text-lg tracking-wide text-white/80 underline decoration-[var(--color-red)] underline-offset-8 hover:text-[var(--color-bone)]"
    >
      office@gregpalast.com
    </a>
  </section>
</Base>
