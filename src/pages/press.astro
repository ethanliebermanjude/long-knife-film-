---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---

<Base
  title="Press — Long Knife"
  description="Press kit, accolades, and media contact for Long Knife, a true crime documentary narrated by Robert De Niro."
>
  <PageHero
    eyebrow="For Journalists"
    title="PRESS"
    subtitle="Materials, accolades, and contact for the press."
  />

  <!-- EPK download -->
  <section class="border-b border-white/10 bg-black/30 px-6 py-20">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center">
      <p
        class="text-xs tracking-[0.4em] text-[var(--color-rust)] uppercase"
      >
        Press Kit
      </p>
      <h2
        class="font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
      >
        Download the EPK.
      </h2>
      <p class="max-w-2xl text-white/70">
        Stills, key art, logo lockup, synopsis, credits, and bios &mdash;
        packaged for press use.
      </p>
      <a
        href="#"
        class="inline-flex items-center gap-3 border border-[var(--color-bone)] px-8 py-4 text-xs tracking-[0.3em] uppercase transition-colors hover:bg-[var(--color-bone)] hover:text-[var(--color-ink)]"
      >
        Download EPK (.zip) <span class="text-white/40">[TK]</span>
      </a>
    </div>
  </section>

  <!-- Accolades -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <p
        class="mb-4 text-center text-xs tracking-[0.4em] text-[var(--color-rust)] uppercase"
      >
        Selections &amp; Awards
      </p>
      <h2
        class="text-center font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl"
      >
        Accolades.
      </h2>
      <div class="mt-16 grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-3">
        <div class="border border-white/10 p-8">
          <p class="text-[10px] tracking-[0.3em] text-white/40 uppercase">
            [Festival &mdash; TK]
          </p>
          <p class="mt-3 font-[family-name:var(--font-display)] text-2xl tracking-tight">
            [Award &mdash; TK]
          </p>
        </div>
        <div class="border border-white/10 p-8">
          <p class="text-[10px] tracking-[0.3em] text-white/40 uppercase">
            [Festival &mdash; TK]
          </p>
          <p class="mt-3 font-[family-name:var(--font-display)] text-2xl tracking-tight">
            [Award &mdash; TK]
          </p>
        </div>
        <div class="border border-white/10 p-8">
          <p class="text-[10px] tracking-[0.3em] text-white/40 uppercase">
            [Festival &mdash; TK]
          </p>
          <p class="mt-3 font-[family-name:var(--font-display)] text-2xl tracking-tight">
            [Award &mdash; TK]
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Press contact -->
  <section class="border-t border-white/10 px-6 py-24 text-center">
    <p class="text-xs tracking-[0.4em] text-[var(--color-rust)] uppercase">
      Press Contact
    </p>
    <p class="mt-4 font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl">
      Get in touch.
    </p>
    <a
      href="mailto:office@gregpalast.com"
      class="mt-8 inline-block text-lg tracking-wide text-white/80 underline decoration-[var(--color-rust)] underline-offset-8 hover:text-[var(--color-bone)]"
    >
      office@gregpalast.com
    </a>
  </section>
</Base>
