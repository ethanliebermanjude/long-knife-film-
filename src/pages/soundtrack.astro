---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const musicians = [
  {
    name: "The Osage Singers",
    role: "Traditional Songs",
    bio: "[TK] Voices of the Osage Nation, performing songs that root Long Knife in the language and ceremony of the people whose story it tells.",
  },
  {
    name: "Stevie Salas",
    role: "Guitarist · Composer",
    bio: "[TK] Apache guitarist and producer (Mick Jagger, Rod Stewart) bringing his signature rock-and-roots sound to the film.",
  },
  {
    name: "Mario Grigorov",
    role: "Composer",
    bio: "[TK] Bulgarian-born film composer whose credits include Precious and The Bad Sleep Well, scoring Long Knife's investigative spine.",
  },
  {
    name: "[The German Cellist]",
    role: "Cello",
    bio: "[TK &mdash; need the cellist's name and a one-line bio.]",
  },
];
---

<Base
  title="The Soundtrack — Long Knife"
  description="The music of Long Knife. The Osage Singers, Stevie Salas, Mario Grigorov, and more."
>
  <PageHero
    eyebrow="Chapter 03"
    title="THE SOUNDTRACK"
    subtitle="A score worthy of the story."
  />

  <section class="px-6 py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg leading-relaxed text-white/80 sm:text-xl">
        <span class="text-white/40 italic">
          [Lede &mdash; TK. One paragraph framing the soundtrack as a deliberate
          collaboration between Osage tradition and world-class film
          composition.]
        </span>
      </p>
    </div>
  </section>

  <section class="border-t border-white/10 px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <ul class="grid gap-px bg-white/10 sm:grid-cols-2">
        {
          musicians.map((m) => (
            <li class="bg-[var(--color-ink)] p-10 sm:p-12">
              <p class="text-[10px] tracking-[0.3em] text-[var(--color-rust)] uppercase">
                {m.role}
              </p>
              <p class="mt-3 font-[family-name:var(--font-display)] text-4xl tracking-tight sm:text-5xl">
                {m.name}
              </p>
              <p class="mt-6 text-base leading-relaxed text-white/70">
                {m.bio}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
